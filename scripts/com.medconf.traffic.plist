<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.medconf.traffic</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ckeithw/Documents/Claude projects/medconf/scripts/traffic-report.sh</string>
    </array>

    <!-- Mondays 08:20. Deliberately well before com.medconf.update (Mon 14:07) so the two
         jobs never touch the same git checkout at once. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/ckeithw/Documents/Claude projects/medconf/logs/traffic.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ckeithw/Documents/Claude projects/medconf/logs/traffic.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/ckeithw</string>
    </dict>
</dict>
</plist>
